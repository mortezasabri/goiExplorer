Package: goiExplorer
Title: Explore a Gene of Interest in RNA-Seq Data
Version: 0.2.0
Authors@R:
  person(
    given = "Morteza",
    family = "Sabri",
    email = "morteza_sabri@icloud.com",
    role = c("aut", "cre"),
    comment = c("Bioinformatician", "Research software engineer")
